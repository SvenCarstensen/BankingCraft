import { ScrollView, ListView, LineEdit, ComboBox, CheckBox, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { TxRow, BarStat, MonthStat } from "types.slint";
import { Icon, Icons, Card, CardHeader, PrimaryButton, GhostButton, Chip, Avatar, LabeledField, SegmentedControl, Separator } from "widgets.slint";

// ------------------------------------------------------------------ shared pieces

component TxLine inherits Rectangle {
    in property <TxRow> item;
    in property <bool> selected;
    in property <bool> compact;
    callback clicked;
    height: item.is-header ? 34px : (compact ? 52px : 60px);
    background: item.is-header ? Theme.header-bg : selected ? Theme.row-selected : touch.has-hover ? Theme.row-hover : item.pending ? Theme.pending-bg : transparent;
    if item.is-header: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: item.date-label;
            font-weight: 650;
            font-size: Theme.font-small;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: item.day-balance;
            font-size: Theme.font-small;
            color: Theme.text-muted;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    if !item.is-header: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Avatar {
            text: item.initial;
            tint: item.cat-color;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: item.name;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
            }
            Text {
                text: compact ? item.purpose : item.purpose + (item.account != "" ? "  ·  " + item.account : "");
                font-size: Theme.font-small;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        if item.pending: Rectangle {
            width: 70px;
            Chip {
                text: @tr("vorgemerkt");
                tint: Theme.warning;
                background: Theme.pending-chip;
                height: 18px;
                label-size: 11px;
                width: parent.width;
                y: (parent.height - self.height) / 2;
            }
        }
        if !compact: Rectangle {
            width: 120px;
            Chip {
                text: item.category;
                tint: item.cat-color;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
            }
        }
        Text {
            width: 110px;
            text: item.amount;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-weight: 650;
            color: item.negative ? Theme.negative : Theme.positive;
        }
    }
    if !item.is-header: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.card-border.with-alpha(0.6);
    }
    touch := TouchArea {
        enabled: !item.is-header;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BarList inherits VerticalLayout {
    in property <[BarStat]> stats;
    spacing: 10px;
    for s in stats: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            Text {
                text: s.label;
                font-size: 13px;
                color: Theme.text;
            }
            Text {
                text: s.value;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: right;
                color: Theme.text;
            }
        }
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.track-bg;
            Rectangle {
                x: 0;
                width: parent.width * max(0.02, s.ratio);
                height: parent.height;
                border-radius: 4px;
                background: s.color;
            }
        }
    }
    if stats.length == 0: Text {
        text: @tr("Noch keine Daten in diesem Zeitraum.");
        color: Theme.text-faint;
        font-size: 13px;
    }
}

component MonthChart inherits VerticalLayout {
    in property <[MonthStat]> months;
    spacing: 8px;
    HorizontalLayout {
        spacing: 14px;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: Theme.positive;
            y: 3px;
        }
        Text {
            text: @tr("Einnahmen");
            font-size: 12px;
            color: Theme.text-muted;
        }
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: Theme.negative;
            y: 3px;
        }
        Text {
            text: @tr("Ausgaben");
            font-size: 12px;
            color: Theme.text-muted;
        }
        Rectangle { }
    }
    HorizontalLayout {
        height: 170px;
        spacing: 10px;
        for m in months: VerticalLayout {
            spacing: 4px;
            Rectangle {
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 3px;
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        Rectangle {
                            y: parent.height - self.height;
                            height: parent.height * max(0.01, m.income);
                            border-radius: 3px;
                            background: Theme.positive;
                        }
                    }
                    Rectangle {
                        width: 14px;
                        Rectangle {
                            y: parent.height - self.height;
                            height: parent.height * max(0.01, m.expense);
                            border-radius: 3px;
                            background: Theme.negative;
                        }
                    }
                }
                ta := TouchArea { }
                if ta.has-hover: Rectangle {
                    y: 0;
                    height: 44px;
                    width: 120px;
                    x: (parent.width - self.width) / 2;
                    background: Theme.tooltip-bg;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 5px;
                        spacing: 4px;
                        Text {
                            text: "+ " + m.income-text;
                            color: Theme.tooltip-text;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "− " + m.expense-text;
                            color: Theme.tooltip-text;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
            Text {
                text: m.label;
                font-size: 11px;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}

component PageTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 10px;
    VerticalLayout {
        alignment: start;
        spacing: 4px;
        Text {
            text: title;
            font-size: 24px;
            font-weight: 700;
            color: Theme.text;
        }
        if subtitle != "": Text {
            text: subtitle;
            color: Theme.text-muted;
            font-size: 13px;
        }
    }
    @children
}

// ------------------------------------------------------------------ overview

export component OverviewPage inherits ScrollView {
    mouse-drag-pan-enabled: false;
    property <int> drag-source: -1;
    property <int> drag-target: -1;
    property <bool> drag-after;
    property <bool> drag-armed;
    property <bool> drag-active;
    property <bool> was-dragged;
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        PageTitle {
            title: @tr("Finanzübersicht");
            subtitle: AppState.last-sync;
        }
        HorizontalLayout {
            spacing: 18px;
            // total balance tile
            Card {
                horizontal-stretch: 2;
                min-height: max(230px, balance-content.preferred-height);
                background: @linear-gradient(135deg, #1e6fd9 0%, #13233a 100%);
                border-width: 0;
                balance-content := VerticalLayout {
                    padding: 22px;
                    spacing: 10px;
                    Text {
                        text: @tr("Gesamtsaldo aller Konten");
                        color: #c9d9f2;
                        font-size: 13px;
                    }
                    Text {
                        text: AppState.total-balance;
                        color: #ffffff;
                        font-size: Theme.font-huge;
                        font-weight: 700;
                    }
                    Rectangle { height: 14px; }
                    Text {
                        text: AppState.month-label;
                        color: #c9d9f2;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 28px;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: @tr("Einnahmen");
                                color: #a8c2e8;
                                font-size: 12px;
                            }
                            Text {
                                text: AppState.month-income;
                                color: #7ff0b0;
                                font-size: 18px;
                                font-weight: 650;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: @tr("Ausgaben");
                                color: #a8c2e8;
                                font-size: 12px;
                            }
                            Text {
                                text: AppState.month-expense;
                                color: #ffb3b8;
                                font-size: 18px;
                                font-weight: 650;
                            }
                        }
                        Rectangle { }
                    }
                    if AppState.account-groups.length > 0: VerticalLayout {
                        vertical-stretch: 0;
                        padding-top: 20px;
                        spacing: 10px;
                        Text {
                            text: @tr("Gruppensalden");
                            color: #c9d9f2;
                            font-size: 12px;
                        }
                        for g in AppState.account-groups: Rectangle {
                            background: #ffffff12;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 9px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: g.name;
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                    VerticalLayout {
                                        spacing: 7px;
                                        for b in g.balances: Text {
                                            text: b.amount;
                                            color: b.negative ? #ffb3b8 : #ffffff;
                                            font-size: 18px;
                                            font-weight: 650;
                                            horizontal-alignment: right;
                                        }
                                        if g.balances.length == 0: Text {
                                            text: "–";
                                            color: #c9d9f2;
                                            font-size: 18px;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }
                                Text {
                                    text: g.balance-note;
                                    color: #c9d9f2;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: start;
                        Rectangle {
                            height: 32px;
                            width: rt.preferred-width + 28px;
                            border-radius: 16px;
                            background: rta.has-hover ? #ffffff33 : #ffffff22;
                            rt := Text {
                                text: @tr("Umsätze abrufen");
                                color: #ffffff;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            rta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppState.refresh-all(); }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            // accounts tile
            Card {
                horizontal-stretch: 3;
                VerticalLayout {
                    padding: 18px;
                    spacing: 4px;
                    CardHeader {
                        title: @tr("Konten");
                        subtitle: AppState.accounts.length + @tr(" Konten · Zum Sortieren ziehen");
                        GhostButton {
                            text: @tr("Alle anzeigen");
                            clicked => { AppState.navigate(1); }
                        }
                    }
                    for a in AppState.accounts: account-row := Rectangle {
                        height: max(54px, account-content.preferred-height);
                        property <int> layout-account-id: a.id;
                        changed layout-account-id => { AppState.account-row-layout(a.id, self.y, self.height); }
                        changed y => { AppState.account-row-layout(a.id, self.y, self.height); }
                        changed height => { AppState.account-row-layout(a.id, self.y, self.height); }
                        init => { AppState.account-row-layout(a.id, self.y, self.height); }
                        border-radius: 6px;
                        background: root.drag-active && root.drag-target == a.id ? Theme.row-selected : root.drag-active && root.drag-source == a.id ? Theme.header-bg : at.has-hover ? Theme.row-hover : transparent;
                        account-content := HorizontalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 12px;
                            Text { text: "⠿"; color: Theme.text-faint; width: 14px; vertical-alignment: center; font-size: 18px; }
                            Rectangle {
                                width: 4px;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 2px;
                                background: a.color;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                alignment: center;
                                spacing: 6px;
                                account-name := Text {
                                    text: a.name;
                                    font-weight: 600;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: a.bank + "  ·  " + a.iban;
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                            Text {
                                text: a.balance;
                                horizontal-stretch: 0;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                font-weight: 650;
                                color: a.negative ? Theme.negative : Theme.text;
                            }
                        }
                        at := TouchArea {
                            enabled: !AppState.busy;
                            mouse-cursor: move;
                            function update-target() {
                                if self.mouse-x < 0px || self.mouse-x > self.width {
                                    root.drag-target = -1;
                                } else {
                                    let target = AppState.account-drop-target(account-row.y + self.mouse-y);
                                    root.drag-target = target.id;
                                    root.drag-after = target.after;
                                }
                            }
                            moved => {
                                if root.drag-armed && root.drag-source == a.id {
                                    if Math.abs((self.mouse-x - self.pressed-x) / 1px) > 6 || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 6 {
                                        root.drag-active = true;
                                        root.was-dragged = true;
                                    }
                                    if root.drag-active { self.update-target(); }
                                }
                            }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    root.drag-source = a.id;
                                    root.drag-target = -1;
                                    root.drag-armed = true;
                                    root.drag-active = false;
                                    root.was-dragged = false;
                                } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                    root.drag-armed = false;
                                    if root.drag-active {
                                        self.update-target();
                                        root.drag-active = false;
                                        if root.drag-target >= 0 {
                                            AppState.move-account(a.id, root.drag-target, root.drag-after);
                                        }
                                    }
                                    root.drag-target = -1;
                                } else if event.kind == PointerEventKind.cancel {
                                    root.drag-armed = false;
                                    root.drag-active = false;
                                    root.drag-target = -1;
                                }
                            }
                            clicked => { if !root.was-dragged { AppState.open-account(a.id); } }
                        }
                        if root.drag-active && root.drag-target == a.id: Rectangle {
                            y: root.drag-after ? parent.height - 2px : 0px;
                            height: 2px;
                            background: Theme.accent;
                        }
                    }
                    if AppState.accounts.length == 0: VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: @tr("Noch kein Bankzugang eingerichtet.");
                            color: Theme.text-muted;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            PrimaryButton {
                                text: @tr("Bankzugang einrichten");
                                icon: Icons.plus;
                                clicked => { AppState.navigate(6); AppState.new-access(); }
                            }
                            GhostButton {
                                text: @tr("Demo-Daten laden");
                                clicked => { AppState.load-demo(); }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
        HorizontalLayout {
            spacing: 18px;
            Card {
                horizontal-stretch: 3;
                VerticalLayout {
                    padding-top: 18px;
                    padding-bottom: 8px;
                    CardHeader {
                        padding-left: 18px;
                        padding-right: 18px;
                        title: @tr("Letzte Umsätze");
                        GhostButton {
                            text: @tr("Umsatzliste");
                            clicked => { AppState.navigate(2); }
                        }
                    }
                    for r in AppState.recent: TxLine {
                        item: r;
                        compact: true;
                        clicked => { AppState.navigate(2); AppState.tx-select(r.index); }
                    }
                    if AppState.recent.length == 0: Text {
                        x: 18px;
                        text: @tr("Keine Umsätze vorhanden.");
                        color: Theme.text-faint;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Card {
                horizontal-stretch: 2;
                VerticalLayout {
                    padding: 18px;
                    CardHeader {
                        title: @tr("Ausgaben nach Kategorie");
                        subtitle: AppState.month-label;
                    }
                    BarList { stats: AppState.category-stats; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
        HorizontalLayout {
            spacing: 18px;
            Card {
                horizontal-stretch: 3;
                VerticalLayout {
                    padding: 18px;
                    CardHeader {
                        title: @tr("Einnahmen & Ausgaben");
                        subtitle: @tr("Letzte 6 Monate, alle Konten");
                    }
                    MonthChart { months: AppState.months; }
                }
            }
            Card {
                horizontal-stretch: 2;
                VerticalLayout {
                    padding: 18px;
                    spacing: 6px;
                    CardHeader {
                        title: @tr("Anstehende Daueraufträge");
                        GhostButton {
                            text: @tr("Verwalten");
                            clicked => { AppState.navigate(4); }
                        }
                    }
                    for s in AppState.upcoming: HorizontalLayout {
                        height: 44px;
                        spacing: 10px;
                        Icon {
                            name: Icons.repeat;
                            color: Theme.accent;
                            y: (parent.height - self.height) / 2;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: s.name;
                                font-weight: 600;
                                overflow: elide;
                                color: Theme.text;
                            }
                            Text {
                                text: s.next;
                                font-size: 12px;
                                color: Theme.text-muted;
                            }
                        }
                        Text {
                            text: s.amount;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: Theme.negative;
                            font-weight: 600;
                        }
                    }
                    if AppState.upcoming.length == 0: Text {
                        text: @tr("Keine Daueraufträge bekannt. Unter Zahlungsverkehr → Daueraufträge abrufen.");
                        wrap: word-wrap;
                        color: Theme.text-faint;
                        font-size: 13px;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ accounts

export component AccountsPage inherits ScrollView {
    VerticalLayout {
        alignment: start;
        padding: 24px;
        spacing: 18px;
        PageTitle {
            title: @tr("Konten");
            subtitle: @tr("Konten nach eigenen Gruppen ordnen");
            Rectangle { }
            PrimaryButton { text: @tr("Kontenrundruf"); icon: Icons.refresh; clicked => { AppState.refresh-all(); } }
        }
        HorizontalLayout {
            spacing: 12px;
            LineEdit {
                text <=> AppState.new-group-name;
                placeholder-text: @tr("Neue Gruppe, z. B. Privat");
                accepted => { AppState.create-group(self.text); }
            }
            PrimaryButton { text: @tr("Gruppe anlegen"); clicked => { AppState.create-group(AppState.new-group-name); } }
        }
        for g in AppState.account-groups: Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    if g.id == 0: Text { text: g.name; font-weight: 700; color: Theme.text; }
                    if g.id != 0: HorizontalLayout {
                        spacing: 8px;
                        group-title := LineEdit { text: g.name; accepted => { AppState.rename-group(g.id, self.text); } }
                        GhostButton { text: @tr("Umbenennen"); clicked => { AppState.rename-group(g.id, group-title.text); } }
                        GhostButton { text: @tr("Entfernen"); clicked => { AppState.delete-group(g.id); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: g.accounts.length + @tr(" Konten"); font-size: 12px; color: Theme.text-muted; }
                }
                for a in g.accounts: Rectangle {
                    height: account-details.preferred-height;
                    background: Theme.header-bg;
                    border-radius: 8px;
                    account-details := HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Rectangle { width: 4px; border-radius: 2px; background: a.color; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 9px;
                            HorizontalLayout {
                                spacing: 16px;
                                account-name := Text { text: a.name; horizontal-stretch: 1; wrap: word-wrap; font-weight: 600; color: Theme.text; }
                                Text { text: a.balance; horizontal-stretch: 0; horizontal-alignment: right; font-weight: 700; color: a.negative ? Theme.negative : Theme.text; }
                            }
                            Text { text: a.iban; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                            Text { text: a.bank + " · " + a.owner; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: @tr("Gruppe"); vertical-alignment: center; font-size: 11px; color: Theme.text-muted; }
                                ComboBox {
                                    width: 160px;
                                    model: AppState.group-names;
                                    current-index: a.group-index;
                                    selected(value) => { AppState.assign-group(a.id, self.current-index); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                rename-account := GhostButton { text: @tr("Anzeigename ändern"); clicked => { AppState.edit-account-name(a.id); } }
                                GhostButton { text: @tr("Umsätze"); clicked => { AppState.open-account(a.id); } }
                            }
                        }
                    }
                }
                if g.accounts.length == 0: Text {
                    text: @tr("Noch keine Konten in dieser Gruppe. Wählen Sie die Gruppe direkt am gewünschten Konto.");
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component DetailLine inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    visible: value != "";
    height: value != "" ? self.preferred-height : 0;
    spacing: 6px;
    Text {
        text: label;
        font-size: 11px;
        color: Theme.text-faint;
    }
    Text {
        text: value;
        font-size: 13px;
        wrap: word-wrap;
        color: Theme.text;
    }
}

// ------------------------------------------------------------------ transactions

export component TransactionsPage inherits Rectangle {
    property <[string]> periods: [@tr("30 Tage"), @tr("90 Tage"), @tr("Dieses Jahr"), @tr("Alle")];
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        PageTitle {
            title: @tr("Umsätze");
            subtitle: AppState.tx-summary;
            Rectangle { }
            GhostButton {
                text: "CSV";
                icon: Icons.download;
                clicked => { AppState.export-csv(); }
            }
            GhostButton {
                text: "camt.052";
                icon: Icons.download;
                clicked => { AppState.export-camt(); }
            }
            PrimaryButton {
                text: @tr("Aktualisieren");
                icon: Icons.refresh;
                clicked => { AppState.refresh-all(); }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            ComboBox {
                width: 260px;
                model: AppState.account-names;
                current-index <=> AppState.tx-account;
                selected => { AppState.tx-filter-changed(); }
            }
            SegmentedControl {
                width: 360px;
                options: periods;
                selected <=> AppState.tx-period;
                changed => { AppState.tx-filter-changed(); }
            }
            LineEdit {
                placeholder-text: @tr("Suche nach Name, Zweck, IBAN oder Betrag …");
                text <=> AppState.tx-search;
                edited => { AppState.tx-filter-changed(); }
            }
        }
        Flickable {
            height: 26px;
            content-width: chips.preferred-width;
            interactive: true;
            chips := HorizontalLayout {
                height: 24px;
                y: (parent.height - self.height) / 2;
                spacing: 6px;
            Chip {
                text: @tr("Alle Kategorien");
                tint: Theme.accent;
                selected: AppState.tx-category == "";
                clicked => { AppState.tx-category = ""; AppState.tx-filter-changed(); }
            }
            for c[i] in AppState.categories: Chip {
                text: AppState.category-labels[i];
                tint: AppState.category-colors[i];
                selected: AppState.tx-category == c;
                clicked => {
                    AppState.tx-category = AppState.tx-category == c ? "" : c;
                    AppState.tx-filter-changed();
                }
            }
            }
        }
        HorizontalLayout {
            spacing: 18px;
            vertical-stretch: 1;
            Card {
                horizontal-stretch: 1;
                clip: true;
                ListView {
                    for r in AppState.tx-rows: TxLine {
                        item: r;
                        selected: AppState.tx-detail.valid && AppState.tx-detail.index == r.index && !r.is-header;
                        clicked => { AppState.tx-select(r.index); }
                    }
                }
                if AppState.tx-rows.length == 0: Text {
                    text: @tr("Keine Umsätze für diese Auswahl.");
                    color: Theme.text-faint;
                }
            }
            Card {
                width: 340px;
                if !AppState.tx-detail.valid: VerticalLayout {
                    alignment: center;
                    padding: 24px;
                    Text {
                        text: @tr("Wählen Sie einen Umsatz aus, um Details zu sehen und die Kategorie zu ändern.");
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        color: Theme.text-faint;
                    }
                }
                if AppState.tx-detail.valid: ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        Text {
                            text: AppState.tx-detail.amount;
                            font-size: 28px;
                            font-weight: 700;
                            color: AppState.tx-detail.negative ? Theme.negative : Theme.positive;
                        }
                        Text {
                            text: AppState.tx-detail.name;
                            font-size: 16px;
                            font-weight: 600;
                            wrap: word-wrap;
                            color: Theme.text;
                        }
                        if AppState.tx-detail.pending: Text {
                            text: @tr("Vorgemerkter Umsatz – noch nicht gebucht");
                            color: Theme.warning;
                            font-size: 12px;
                        }
                        Separator { }
                        DetailLine { label: @tr("Konto"); value: AppState.tx-detail.account; }
                        DetailLine { label: @tr("Buchungstag"); value: AppState.tx-detail.booking-date; }
                        DetailLine { label: @tr("Wertstellung"); value: AppState.tx-detail.value-date; }
                        DetailLine { label: "IBAN"; value: AppState.tx-detail.iban; }
                        DetailLine { label: "BIC"; value: AppState.tx-detail.bic; }
                        DetailLine { label: @tr("Verwendungszweck"); value: AppState.tx-detail.purpose; }
                        DetailLine { label: @tr("Buchungstext"); value: AppState.tx-detail.posting-text; }
                        DetailLine { label: @tr("End-to-End-Referenz"); value: AppState.tx-detail.eref; }
                        DetailLine { label: @tr("Mandatsreferenz"); value: AppState.tx-detail.mref; }
                        DetailLine { label: @tr("Gläubiger-ID"); value: AppState.tx-detail.creditor-id; }
                        Separator { }
                        Text {
                            text: @tr("Kategorie");
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text-muted;
                        }
                        ComboBox {
                            model: AppState.category-labels;
                            current-value: AppState.tx-detail.category;
                            selected(v) => { AppState.set-category(AppState.tx-detail.index, AppState.categories[self.current-index]); }
                        }
                        Text {
                            text: @tr("Gleiche Gegenparteien werden künftig automatisch so kategorisiert.");
                            font-size: 11px;
                            wrap: word-wrap;
                            color: Theme.text-faint;
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ transfer

export component TransferPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        alignment: start;
        PageTitle {
            title: @tr("Überweisung");
            subtitle: @tr("SEPA-Überweisung, Echtzeitüberweisung oder Terminüberweisung");
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                Text { text: @tr("Auftraggeberkonto"); font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                ComboBox {
                    model: AppState.sepa-accounts;
                    current-index <=> AppState.tf-account;
                    selected(_) => { AppState.payment-account-changed(); }
                }
                Separator { }
                Text { text: @tr("Adressbuch dieses Kontos"); font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                HorizontalLayout {
                    spacing: 12px;
                    ComboBox {
                        horizontal-stretch: 1;
                        model: AppState.recipient-names;
                        current-index <=> AppState.tf-recipient;
                        selected(_) => { AppState.select-recipient(self.current-index); }
                    }
                    GhostButton {
                        text: @tr("Empfänger löschen"); icon: Icons.trash;
                        enabled: !AppState.busy && AppState.tf-recipient > 0;
                        clicked => { AppState.delete-recipient(); }
                    }
                }
                LabeledField {
                    label: @tr("Empfänger");
                    placeholder: @tr("Name des Empfängers");
                    text <=> AppState.tf-name;
                    accepted => { AppState.save-transfer(); }
                }
                HorizontalLayout {
                    spacing: 12px;
                    LabeledField {
                        horizontal-stretch: 3;
                        label: "IBAN";
                        placeholder: "DE00 0000 0000 0000 0000 00";
                        text <=> AppState.tf-iban;
                        accepted => { AppState.save-transfer(); }
                        hint: AppState.tf-iban-hint;
                        error: AppState.tf-iban-error;
                        edited(t) => { AppState.check-iban(t); }
                    }
                    LabeledField {
                        width: 200px;
                        label: @tr("BIC (optional)");
                        placeholder: @tr("optional");
                        text <=> AppState.tf-bic;
                        accepted => { AppState.save-transfer(); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    transfer-amount := LabeledField {
                        width: 180px;
                        label: @tr("Betrag (EUR)");
                        placeholder: "0,00";
                        text <=> AppState.tf-amount;
                        accepted => { AppState.save-transfer(); }
                    }
                    LabeledField {
                        label: @tr("Verwendungszweck");
                        placeholder: @tr("max. 140 Zeichen");
                        text <=> AppState.tf-purpose;
                        accepted => { AppState.save-transfer(); }
                        hint: AppState.tf-purpose.character-count + " / 140";
                        error: AppState.tf-purpose.character-count > 140;
                    }
                }
                CheckBox {
                    text: @tr("Im Adressbuch speichern");
                    checked <=> AppState.tf-save-recipient;
                }
                Text { text: @tr("Ausführung"); font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                HorizontalLayout {
                    spacing: 12px;
                    SegmentedControl {
                        width: 420px;
                        options: [@tr("Standard"), @tr("Echtzeit"), @tr("Terminüberweisung")];
                        selected <=> AppState.tf-mode;
                    }
                    if AppState.tf-mode == 2: LineEdit {
                        width: 150px;
                        placeholder-text: @tr("TT.MM.JJJJ");
                        text <=> AppState.tf-date;
                        accepted => { AppState.save-transfer(); }
                    }
                }
                Text {
                    text: @tr("Gespeicherte Überweisungen werden bei der nächsten Synchronisierung des Kontos gesendet.");
                    color: Theme.text-muted; font-size: 12px; wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    padding-top: 6px;
                    spacing: 12px;
                    GhostButton {
                        text: @tr("Überweisung senden");
                        icon: Icons.transfer;
                        enabled: !AppState.busy;
                        clicked => { AppState.send-transfer(); }
                    }
                    PrimaryButton {
                        text: @tr("Überweisung speichern");
                        icon: Icons.list;
                        enabled: !AppState.busy;
                        clicked => { AppState.save-transfer(); }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ outgoing orders

export component OrdersPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: start;
        PageTitle {
            title: @tr("Auftragsliste");
            subtitle: @tr("Gespeicherte Überweisungen werden bei der nächsten Synchronisierung des Kontos gesendet.");
        }
        if AppState.payment-orders.length == 0: Text {
            text: @tr("Noch keine Überweisungsaufträge gespeichert.");
            color: Theme.text-muted;
        }
        for o in AppState.payment-orders: Card {
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: o.name; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-stretch: 1; overflow: elide; }
                    Chip { text: o.status; tint: o.needs-review ? Theme.negative : o.queued ? Theme.accent : Theme.positive; }
                    Text { text: o.amount; color: Theme.text; font-weight: 600; }
                    GhostButton { icon: Icons.trash; enabled: !AppState.busy; clicked => { AppState.delete-payment-order(o.id); } }
                }
                Text { text: o.account; color: Theme.text-muted; wrap: word-wrap; }
                Text { text: o.iban + " · " + o.execution; color: Theme.text-muted; wrap: word-wrap; }
                Text { text: o.purpose; color: Theme.text; wrap: word-wrap; }
                if o.detail != "": Text { text: o.detail; color: o.needs-review ? Theme.negative : Theme.text-muted; wrap: word-wrap; font-size: 12px; }
            }
        }
    }
}

// ------------------------------------------------------------------ standing orders

export component StandingPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        alignment: start;
        PageTitle {
            title: @tr("Daueraufträge");
            subtitle: @tr("Bestand abrufen, neue Daueraufträge anlegen, bestehende löschen");
            Rectangle { }
            PrimaryButton {
                text: @tr("Bestand abrufen");
                icon: Icons.refresh;
                clicked => { AppState.fetch-standing(); }
            }
        }
        Card {
            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                for s in AppState.standing: Rectangle {
                    height: 66px;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 12px;
                        spacing: 14px;
                        Icon {
                            name: Icons.repeat;
                            color: Theme.accent;
                            y: (parent.height - self.height) / 2;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 2;
                            spacing: 4px;
                            Text { text: s.name; font-weight: 600; color: Theme.text; overflow: elide; }
                            Text { text: s.iban + "  ·  " + s.purpose; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text { text: s.schedule; font-size: 13px; color: Theme.text; }
                            Text { text: s.next + "  ·  " + s.account; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                        }
                        Text { text: s.amount; width: 110px; horizontal-alignment: right; vertical-alignment: center; font-weight: 650; color: Theme.negative; }
                        GhostButton {
                            icon: Icons.trash;
                            y: 14px;
                            clicked => { AppState.delete-standing(s.index); }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.card-border; }
                }
                if AppState.standing.length == 0: Text {
                    x: 18px;
                    height: 40px;
                    vertical-alignment: center;
                    text: @tr("Noch keine Daueraufträge geladen.");
                    color: Theme.text-faint;
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                CardHeader { title: @tr("Neuer Dauerauftrag"); subtitle: @tr("Empfänger, Betrag und Zweck werden aus dem Überweisungsformular übernommen."); }
                Text { text: @tr("Auftraggeberkonto"); font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                ComboBox {
                    model: AppState.sepa-accounts;
                    current-index <=> AppState.tf-account;
                }
                HorizontalLayout {
                    spacing: 12px;
                    LabeledField { label: @tr("Empfänger"); text <=> AppState.tf-name; placeholder: @tr("Name"); }
                    LabeledField {
                        label: "IBAN";
                        text <=> AppState.tf-iban;
                        placeholder: "DE…";
                        hint: AppState.tf-iban-hint;
                        error: AppState.tf-iban-error;
                        edited(t) => { AppState.check-iban(t); }
                    }
                    LabeledField { width: 140px; label: @tr("Betrag (EUR)"); text <=> AppState.tf-amount; placeholder: "0,00"; }
                }
                LabeledField { label: @tr("Verwendungszweck"); text <=> AppState.tf-purpose; placeholder: @tr("z. B. Miete"); }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: @tr("Turnus"); font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                        ComboBox {
                            width: 200px;
                            model: [@tr("monatlich"), @tr("vierteljährlich"), @tr("halbjährlich"), @tr("jährlich"), @tr("wöchentlich")];
                            current-index <=> AppState.so-interval;
                        }
                    }
                    LabeledField { width: 150px; label: @tr("Erste Ausführung"); text <=> AppState.so-first; placeholder: @tr("TT.MM.JJJJ"); }
                    LabeledField { width: 120px; label: @tr("Ausführungstag"); text <=> AppState.so-day; placeholder: @tr("1–31 / 99 = Ultimo"); }
                    LabeledField { width: 150px; label: @tr("Letzte Ausführung"); text <=> AppState.so-last; placeholder: @tr("optional"); }
                    Rectangle { }
                }
                HorizontalLayout {
                    alignment: end;
                    PrimaryButton {
                        text: @tr("Dauerauftrag anlegen");
                        icon: Icons.plus;
                        enabled: !AppState.busy;
                        clicked => { AppState.send-standing(); }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ analysis

export component AnalysisPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        alignment: start;
        PageTitle {
            title: @tr("Auswertungen");
            subtitle: @tr("Einnahmen und Ausgaben nach Kategorien");
            Rectangle { }
            GhostButton {
                text: "‹";
                clicked => { AppState.analysis-shift(-1); }
            }
            Text {
                text: AppState.analysis-label;
                vertical-alignment: center;
                font-weight: 600;
                min-width: 130px;
                horizontal-alignment: center;
                color: Theme.text;
            }
            GhostButton {
                text: "›";
                clicked => { AppState.analysis-shift(1); }
            }
        }
        HorizontalLayout {
            spacing: 18px;
            Card {
                VerticalLayout {
                    padding: 20px;
                    CardHeader { title: @tr("Ausgaben"); subtitle: AppState.analysis-label; }
                    BarList { stats: AppState.analysis-categories; }
                }
            }
            Card {
                VerticalLayout {
                    padding: 20px;
                    CardHeader { title: @tr("Einnahmen"); subtitle: AppState.analysis-label; }
                    BarList { stats: AppState.analysis-income; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 20px;
                CardHeader { title: @tr("Jahresverlauf"); subtitle: @tr("12 Monate bis ") + AppState.analysis-label; }
                MonthChart { months: AppState.analysis-months; }
            }
        }
    }
}

// ------------------------------------------------------------------ bank accesses

export component AccessesPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        alignment: start;
        PageTitle {
            title: @tr("Bankzugänge");
            subtitle: @tr("FinTS PIN/TAN oder HBCI-Chipkarte");
            Rectangle { }
            PrimaryButton {
                text: @tr("Neuer Bankzugang");
                icon: Icons.plus;
                clicked => { AppState.new-access(); }
            }
        }
        for a in AppState.accesses: Card {
            HorizontalLayout {
                padding: 18px;
                spacing: 14px;
                Rectangle {
                    width: 42px;
                    height: 42px;
                    border-radius: 21px;
                    background: Theme.accent-soft;
                    Icon {
                        name: a.card-based ? Icons.reader : Icons.key;
                        color: Theme.accent;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text { text: a.name; font-weight: 650; font-size: 15px; color: Theme.text; }
                    Text { text: a.kind + "  ·  " + a.detail; font-size: 12px; color: Theme.text-muted; }
                    Text { text: @tr("TAN-Verfahren: ") + a.tan-method + "  ·  " + a.accounts + @tr(" Konten") + (a.pin-saved ? @tr("  ·  PIN gespeichert (verschlüsselt)") : ""); font-size: 12px; color: Theme.text-muted; }
                }
                Rectangle { }
                GhostButton { text: @tr("Synchronisieren"); icon: Icons.refresh; y: 12px; clicked => { AppState.sync-access(a.id); } }
                if a.kind == "PIN/TAN": GhostButton { text: @tr("TAN-Verfahren wählen"); y: 12px; clicked => { AppState.reset-tan(a.id); } }
                if a.pin-saved: GhostButton { text: @tr("PIN vergessen"); icon: Icons.lock; y: 12px; clicked => { AppState.forget-pin(a.id); } }
                GhostButton { icon: Icons.trash; y: 12px; clicked => { AppState.delete-access(a.id); } }
            }
        }
        if AppState.af-open: Card {
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                CardHeader { title: @tr("Bankzugang einrichten"); }
                SegmentedControl {
                    width: 560px;
                    options: ["PIN/TAN (FinTS)", @tr("HBCI-Chipkarte (DDV)"), @tr("RDH-Chipkarte (VR-NetWorld-Card)")];
                    selected <=> AppState.af-kind;
                    changed => { AppState.bank-search(AppState.bank-query); }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: @tr("Bank suchen"); font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                    LineEdit {
                        placeholder-text: @tr("Name, Ort, BLZ oder BIC – z. B. „Förde Sparkasse“, „ING“, „Volksbank Kiel“");
                        text <=> AppState.bank-query;
                        edited(t) => { AppState.bank-search(t); }
                    }
                    if AppState.bank-picked != "": Text {
                        text: AppState.bank-picked;
                        font-size: 11px;
                        color: Theme.positive;
                    }
                }
                if AppState.bank-results.length > 0: Rectangle {
                    border-radius: Theme.radius-small;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    clip: true;
                    VerticalLayout {
                        for b in AppState.bank-results: Rectangle {
                            height: 56px;
                            background: bta.has-hover ? Theme.accent-soft : Theme.card-bg;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                Icon { name: Icons.bank; color: Theme.accent; y: (parent.height - self.height) / 2; }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text { text: b.name; font-weight: 600; color: Theme.text; overflow: elide; }
                                    Text { text: b.detail; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                                }
                                Text {
                                    text: b.endpoint;
                                    font-size: 11px;
                                    color: Theme.text-faint;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: 320px;
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.card-border; }
                            bta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppState.bank-pick(b.index); }
                            }
                        }
                    }
                }
                LabeledField { label: @tr("Bezeichnung"); text <=> AppState.af-name; placeholder: @tr("z. B. Förde Sparkasse – privat"); }
                if AppState.af-kind == 0: VerticalLayout {
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        LabeledField { width: 160px; label: @tr("Bankleitzahl"); text <=> AppState.af-blz; placeholder: @tr("8 Ziffern"); }
                        LabeledField { label: @tr("Anmeldename / Benutzerkennung"); text <=> AppState.af-user; }
                        LabeledField { label: @tr("Kunden-ID (optional)"); text <=> AppState.af-customer; }
                    }
                    LabeledField {
                        label: @tr("FinTS-Server-URL");
                        text <=> AppState.af-url;
                        placeholder: "https://…";
                        hint: @tr("Wird über die Banksuche ausgefüllt. Abweichende Adressen finden Sie im Onlinebanking Ihrer Bank (Stichwort „FinTS“). Die PIN wird nicht gespeichert.");
                    }
                }
                if AppState.af-kind == 1 || AppState.af-kind == 2: VerticalLayout {
                    spacing: 14px;
                    GridLayout {
                        spacing-horizontal: 12px;
                        spacing-vertical: 6px;
                        Row {
                            Text { text: @tr("Kartenleser"); font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                            Text { text: @tr("Karteneintrag"); font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                        }
                        Row {
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                height: 40px;
                                ComboBox {
                                    width: parent.width;
                                    min-width: 0px;
                                    y: (parent.height - self.height) / 2;
                                    model: AppState.reader-names;
                                    current-index <=> AppState.af-reader;
                                }
                            }
                            Rectangle {
                                width: 120px;
                                height: 40px;
                                LineEdit {
                                    width: parent.width;
                                    min-width: 0px;
                                    y: (parent.height - self.height) / 2;
                                    text <=> AppState.af-record;
                                    placeholder-text: "1–5";
                                }
                            }
                            Rectangle {
                                width: read-card.width;
                                height: 40px;
                                read-card := GhostButton {
                                    y: (parent.height - self.height) / 2;
                                    text: @tr("Daten von Karte lesen");
                                    icon: Icons.reader;
                                    clicked => { AppState.read-card(); }
                                }
                            }
                        }
                    }
                    GridLayout {
                        spacing-horizontal: 12px;
                        spacing-vertical: 6px;
                        Row {
                            Text { text: @tr("Bankleitzahl"); font-size: 12px; font-weight: 600; color: Theme.text-muted; wrap: word-wrap; }
                            Text { text: @tr("Benutzerkennung"); font-size: 12px; font-weight: 600; color: Theme.text-muted; wrap: word-wrap; }
                            Text { text: @tr("Server (Host oder URL)"); font-size: 12px; font-weight: 600; color: Theme.text-muted; wrap: word-wrap; }
                        }
                        Row {
                            LineEdit { width: 160px; text <=> AppState.af-blz; }
                            LineEdit { horizontal-stretch: 1; min-width: 0px; text <=> AppState.af-user; }
                            LineEdit { horizontal-stretch: 2; min-width: 0px; text <=> AppState.af-url; }
                        }
                        Row {
                            Text {
                                colspan: 3;
                                text: AppState.af-kind == 2 ? @tr("Von der Karte gelesen (RDH, PIN am Leser); HBCI über TCP-Port 3000.") : @tr("Von der Karte gelesen; HBCI über TCP-Port 3000.");
                                font-size: 11px;
                                color: Theme.text-faint;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    GhostButton { y: (parent.height - self.height) / 2; text: @tr("Abbrechen"); clicked => { AppState.af-open = false; } }
                    PrimaryButton { y: (parent.height - self.height) / 2; text: @tr("Speichern & verbinden"); icon: Icons.check; clicked => { AppState.save-access(); } }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ card reader

export component ReaderPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        alignment: start;
        PageTitle {
            title: @tr("Kartenleser");
            subtitle: @tr("PC/SC-Leser für HBCI-Chipkarte und chipTAN USB");
            Rectangle { }
            GhostButton { text: @tr("Neu suchen"); icon: Icons.refresh; clicked => { AppState.reader-refresh(); } }
            PrimaryButton { text: @tr("Leser & Karte prüfen"); icon: Icons.check; clicked => { AppState.reader-diagnose(); } }
        }
        if AppState.cyberjack-found: Card {
            background: Theme.success-bg;
            border-color: Theme.success-border;
            HorizontalLayout {
                padding: 16px;
                spacing: 12px;
                Icon { name: Icons.check; color: Theme.positive; y: 2px; }
                Text {
                    wrap: word-wrap;
                    color: Theme.success-text;
                    text: @tr("REINER SCT cyberJack erkannt. BankingCraft nutzt automatisch die sichere PIN-Eingabe am Pinpad und – sofern der Leser es meldet – chipTAN USB mit Anzeige der Auftragsdaten im Display.");
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                CardHeader { title: @tr("Leser für chipTAN USB"); subtitle: @tr("Wird im TAN-Dialog verwendet"); }
                ComboBox {
                    width: 380px;
                    model: AppState.reader-names;
                    current-index <=> AppState.tan-reader;
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                CardHeader { title: @tr("Diagnose"); subtitle: @tr("Gefundene Leser, gemeldete Features und erkannte Karte"); }
                for line in AppState.reader-report: Text {
                    text: line;
                    font-family: "monospace";
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Theme.text;
                }
                if AppState.reader-report.length == 0: Text {
                    text: @tr("Noch keine Prüfung durchgeführt.");
                    color: Theme.text-faint;
                }
            }
        }
    }
}

// ------------------------------------------------------------------ settings

export component SettingsPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        alignment: start;
        PageTitle { title: @tr("Einstellungen"); }
        Card {
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                CardHeader { title: @tr("Tresore"); subtitle: @tr("Getrennte Tresore für unterschiedliche Konten und Zugangsdaten."); }
                Text { text: AppState.active-vault-name; font-size: 16px; font-weight: 650; color: Theme.text; wrap: word-wrap; }
                Text { text: @tr("Speicherort: ") + AppState.data-path; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: start;
                    PrimaryButton { text: @tr("Tresor wechseln / anlegen"); icon: Icons.lock; enabled: !AppState.busy; clicked => { AppState.manage-vaults(); } }
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                CardHeader { title: @tr("Sprache"); subtitle: @tr("Wählen Sie die Sprache der Anwendung."); }
                ComboBox {
                    width: 320px;
                    enabled: !AppState.busy;
                    model: [@tr("Systemeinstellung"), "Deutsch", "English", "Français", "Español"];
                    current-index <=> AppState.language-mode;
                    selected(value) => { AppState.change-language(self.current-index); }
                }
                Text {
                    text: AppState.language-mode == 0
                        ? @tr("Verwendet die Systemsprache, sofern verfügbar. Andernfalls wird Englisch verwendet.")
                        : @tr("Ihre Auswahl wird sofort angewendet und für den nächsten Start gespeichert.");
                    color: Theme.text-muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                CardHeader { title: @tr("Erscheinungsbild"); subtitle: @tr("Wählen Sie ein helles oder dunkles Design."); }
                ComboBox {
                    width: 320px;
                    model: [@tr("Systemeinstellung"), @tr("Hell"), @tr("Dunkel")];
                    current-index <=> AppState.theme-mode;
                    selected(value) => { AppState.change-theme(self.current-index); }
                }
                Text {
                    text: AppState.theme-mode == 0
                        ? @tr("Folgt automatisch dem Design Ihres Betriebssystems. Änderungen werden sofort übernommen.")
                        : @tr("Ihre Auswahl wird sofort angewendet und für den nächsten Start gespeichert.");
                    color: Theme.text-muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                CardHeader { title: @tr("Tresor-Passwort ändern"); subtitle: @tr("Alle Daten werden lokal mit AES-256-GCM verschlüsselt (Schlüssel per Argon2id)."); }
                HorizontalLayout {
                    spacing: 12px;
                    LabeledField { label: @tr("Aktuelles Passwort"); input-type: password; text <=> AppState.old-password; }
                    LabeledField { label: @tr("Neues Passwort"); input-type: password; text <=> AppState.new-password; }
                }
                HorizontalLayout {
                    alignment: end;
                    PrimaryButton { text: @tr("Passwort ändern"); icon: Icons.lock; clicked => { AppState.change-password(); } }
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 22px;
                spacing: 10px;
                CardHeader { title: @tr("Daten"); }
                HorizontalLayout {
                    alignment: start;
                    GhostButton { text: @tr("Demo-Bankzugang hinzufügen"); clicked => { AppState.load-demo(); } }
                }
            }
        }
    }
}
