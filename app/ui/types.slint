export struct AccountDropTarget {
    id: int,
    after: bool,
}

export struct AccountRow {
    id: int,
    name: string,
    bank: string,
    iban: string,
    owner: string,
    balance: string,
    available: string,
    negative: bool,
    last-sync: string,
    kind: string,
    color: color,
    group-index: int,
    group-name: string,
}

export struct GroupBalanceRow {
    amount: string,
    negative: bool,
}

export struct AccountGroupRow {
    id: int,
    name: string,
    accounts: [AccountRow],
    balances: [GroupBalanceRow],
    balance-note: string,
}


export struct TxRow {
    is-header: bool,
    // header rows
    date-label: string,
    day-balance: string,
    // transaction rows
    index: int,
    name: string,
    purpose: string,
    amount: string,
    negative: bool,
    pending: bool,
    category: string,
    cat-color: color,
    initial: string,
    account: string,
}

export struct TxDetail {
    valid: bool,
    index: int,
    name: string,
    iban: string,
    bic: string,
    amount: string,
    negative: bool,
    booking-date: string,
    value-date: string,
    purpose: string,
    posting-text: string,
    eref: string,
    mref: string,
    creditor-id: string,
    category: string,
    account: string,
    pending: bool,
}

export struct BarStat {
    label: string,
    value: string,
    ratio: float,
    color: color,
}

export struct MonthStat {
    label: string,
    income: float,
    expense: float,
    income-text: string,
    expense-text: string,
}

export struct StandingRow {
    index: int,
    name: string,
    iban: string,
    amount: string,
    purpose: string,
    schedule: string,
    next: string,
    account: string,
}

export struct AccessRow {
    id: int,
    name: string,
    kind: string,
    detail: string,
    tan-method: string,
    accounts: int,
    demo: bool,
    pin-saved: bool,
    card-based: bool,
}

export struct BankRow {
    index: int,
    name: string,
    detail: string,
    endpoint: string,
}

export struct ChoiceRow {
    key: string,
    title: string,
    subtitle: string,
}

export struct Toast {
    visible: bool,
    text: string,
    error: bool,
}

export struct PaymentOrderRow {
    id: int,
    name: string,
    iban: string,
    amount: string,
    purpose: string,
    account: string,
    execution: string,
    status: string,
    detail: string,
    needs-review: bool,
    queued: bool,
}
