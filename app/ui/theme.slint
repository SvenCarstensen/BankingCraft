// BankingCraft design tokens. Layout follows the classic German banking-software
// pattern (dark navigation rail, tile overview, dense transaction list) with
// an own visual identity.

export global Theme {
    // brand
    out property <color> nav-bg: #13233a;
    out property <color> nav-bg-hover: #1d3352;
    out property <color> nav-active: #24508a;
    out property <color> nav-text: #c9d6e8;
    out property <color> nav-text-muted: #7f93ae;
    out property <color> accent: #1e6fd9;
    out property <color> accent-hover: #185bb3;
    out property <color> accent-soft: #e6f0fc;

    // surfaces
    out property <color> page-bg: #f2f5f9;
    out property <color> card-bg: #ffffff;
    out property <color> card-border: #e2e8f0;
    out property <color> row-hover: #f6f9fd;
    out property <color> row-selected: #e8f1fc;
    out property <color> header-bg: #f7f9fc;

    // text
    out property <color> text: #1b2635;
    out property <color> text-muted: #66758a;
    out property <color> text-faint: #97a3b4;

    // semantic
    out property <color> positive: #13834a;
    out property <color> negative: #c8323b;
    out property <color> warning: #b7791f;
    out property <color> pending-bg: #fff7e6;

    out property <length> radius: 10px;
    out property <length> radius-small: 6px;
    out property <length> font-small: 12px;
    out property <length> font-normal: 14px;
    out property <length> font-large: 18px;
    out property <length> font-huge: 30px;
}
