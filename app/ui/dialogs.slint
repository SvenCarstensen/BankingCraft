import { LineEdit, ScrollView, Spinner, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Icon, Icons, PrimaryButton, GhostButton } from "widgets.slint";

component Modal inherits Rectangle {
    in property <length> dialog-width: 460px;
    background: #0b1424a0;
    TouchArea { }
    Rectangle {
        width: dialog-width;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: max(20px, (parent.height - self.height) / 2);
        background: Theme.card-bg;
        border-radius: 14px;
        drop-shadow-blur: 30px;
        drop-shadow-color: #0000004d;
        content := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            @children
        }
    }
}

export component AccountNameDialog inherits Modal {
    dialog-width: 540px;
    Text { text: @tr("Anzeigename ändern"); font-size: 18px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
    Text { text: AppState.account-name-context; color: Theme.text-muted; wrap: word-wrap; }
    Text { text: @tr("Kontoname der Bank") + ": " + AppState.account-bank-name; color: Theme.text-muted; wrap: word-wrap; }
    Text { text: @tr("Anzeigename"); font-weight: 600; color: Theme.text; }
    account-name := LineEdit {
        text <=> AppState.account-name-draft;
        placeholder-text: AppState.account-bank-name;
        accepted => { AppState.save-account-name(); }
    }
    Text { text: @tr("Leer lassen, um den Kontonamen der Bank zu verwenden."); color: Theme.text-muted; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 10px;
        GhostButton { text: @tr("Originalnamen verwenden"); clicked => { AppState.account-name-draft = ""; account-name.focus(); } }
        Rectangle { horizontal-stretch: 1; }
        GhostButton { text: @tr("Abbrechen"); clicked => { AppState.show-account-name = false; } }
        PrimaryButton { text: @tr("Speichern"); clicked => { AppState.save-account-name(); } }
    }
    init => { account-name.focus(); }
}

export component PinDialog inherits Modal {
    VerticalLayout {
        spacing: 10px;
        Text { text: AppState.pin-heading; font-size: 18px; font-weight: 700; color: Theme.text; }
        Text { text: AppState.pin-title; color: Theme.text-muted; wrap: word-wrap; }
    }
    HorizontalLayout {
        spacing: 8px;
        pin := LineEdit {
            input-type: AppState.pin-masked ? InputType.password : InputType.text;
            placeholder-text: AppState.pin-masked ? "PIN" : "";
            text <=> AppState.pin-value;
            accepted => { AppState.pin-ok(); }
        }
        GhostButton {
            text: @tr("Einfügen");
            icon: Icons.paste;
            y: (parent.height - self.height) / 2;
            clicked => {
                AppState.pin-paste();
                pin.focus();
            }
        }
    }
    if AppState.pin-offer-save: CheckBox {
        text: @tr("PIN für diesen Bankzugang speichern (verschlüsselt im Tresor)");
        checked <=> AppState.pin-save;
    }
    Text {
        text: AppState.paste-note != "" ? AppState.paste-note : AppState.pin-save ? @tr("Die PIN wird mit AES-256-GCM verschlüsselt im Tresor abgelegt und künftig automatisch verwendet.") : AppState.pin-masked ? @tr("Die PIN wird nur für diese Sitzung im Arbeitsspeicher gehalten.") : @tr("Wird zusammen mit dem Bankzugang gespeichert.");
        font-size: 11px;
        color: Theme.text-faint;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 10px;
        GhostButton { text: @tr("Abbrechen"); clicked => { AppState.pin-cancel(); } }
        PrimaryButton { text: "OK"; clicked => { AppState.pin-ok(); } }
    }
    init => { pin.focus(); }
}

export component PinpadOverlay inherits Modal {
    dialog-width: 420px;
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 26px;
            background: Theme.accent-soft;
            Icon { name: Icons.reader; color: Theme.accent; width: 28px; height: 28px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 8px;
            Text { text: @tr("Bitte am Kartenleser bestätigen"); font-size: 16px; font-weight: 700; color: Theme.text; }
            Text { text: AppState.pinpad-text; wrap: word-wrap; color: Theme.text-muted; }
        }
    }
}

export component TanDialog inherits Modal {
    dialog-width: 560px;
    Text { text: AppState.tan-title; font-size: 18px; font-weight: 700; color: Theme.text; }
    ScrollView {
        height: min(170px, challenge.preferred-height + 8px);
        challenge := Text {
            text: AppState.tan-text;
            wrap: word-wrap;
            color: Theme.text;
            width: 500px;
        }
    }
    // chipTAN optical flicker code
    if AppState.tan-kind == 1: VerticalLayout {
        spacing: 10px;
        alignment: center;
        Rectangle {
            height: AppState.flicker-width * 0.42 + 26px;
            background: #000000;
            border-radius: 8px;
            Rectangle {
                width: AppState.flicker-width;
                height: AppState.flicker-width * 0.42;
                // alignment triangles for the generator
                Path {
                    x: parent.width * 0.1 - 8px;
                    y: -16px;
                    width: 16px;
                    height: 12px;
                    commands: "M0 0 L16 0 L8 12 Z";
                    fill: #ffffff;
                }
                Path {
                    x: parent.width * 0.9 - 8px;
                    y: -16px;
                    width: 16px;
                    height: 12px;
                    commands: "M0 0 L16 0 L8 12 Z";
                    fill: #ffffff;
                }
                HorizontalLayout {
                    spacing: AppState.flicker-width * 0.04;
                    Rectangle { background: AppState.flick0 ? #ffffff : #000000; }
                    Rectangle { background: AppState.flick1 ? #ffffff : #000000; }
                    Rectangle { background: AppState.flick2 ? #ffffff : #000000; }
                    Rectangle { background: AppState.flick3 ? #ffffff : #000000; }
                    Rectangle { background: AppState.flick4 ? #ffffff : #000000; }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            GhostButton { text: @tr("Langsamer"); clicked => { AppState.flicker-speed(-2); } }
            GhostButton { text: @tr("Schneller"); clicked => { AppState.flicker-speed(2); } }
            GhostButton { text: @tr("Kleiner"); clicked => { AppState.flicker-width = max(160px, AppState.flicker-width - 20px); } }
            GhostButton { text: @tr("Größer"); clicked => { AppState.flicker-width = min(480px, AppState.flicker-width + 20px); } }
        }
        Text {
            text: @tr("Karte in den TAN-Generator stecken, „F“ drücken und das Gerät an die Markierungen halten (") + AppState.flicker-hz + " Hz).";
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if AppState.tan-kind == 2: HorizontalLayout {
        alignment: center;
        Image {
            source: AppState.tan-image;
            width: 240px;
            height: 240px;
            image-fit: contain;
            image-rendering: pixelated;
        }
    }
    if AppState.tan-usb-possible: Rectangle {
        height: 54px;
        border-radius: 8px;
        background: Theme.accent-soft;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            spacing: 12px;
            Icon { name: Icons.reader; color: Theme.accent; y: (parent.height - self.height) / 2; }
            Text {
                text: @tr("TAN mit chipTAN-USB-Leser erzeugen (Daten am Leser-Display prüfen)");
                vertical-alignment: center;
                wrap: word-wrap;
                color: Theme.text;
                font-size: 13px;
            }
            PrimaryButton {
                text: @tr("Am Leser");
                y: 9px;
                clicked => { AppState.tan-usb(); }
            }
        }
    }
    if AppState.tan-kind == 3: Rectangle {
        height: 60px;
        border-radius: 8px;
        background: Theme.accent-soft;
        Text {
            text: @tr("Bitte geben Sie den Auftrag in Ihrer Banking-App frei\nund klicken Sie anschließend auf „Freigegeben“.");
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Theme.text;
        }
    }
    if AppState.tan-kind != 3: HorizontalLayout {
        spacing: 8px;
        tan := LineEdit {
            placeholder-text: "TAN";
            text <=> AppState.tan-value;
            accepted => { AppState.tan-ok(); }
        }
        GhostButton {
            text: @tr("Einfügen");
            icon: Icons.paste;
            y: (parent.height - self.height) / 2;
            clicked => {
                AppState.tan-paste();
                tan.focus();
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 10px;
        GhostButton { text: @tr("Abbrechen"); clicked => { AppState.tan-cancel(); } }
        if AppState.tan-kind == 3: PrimaryButton { text: @tr("Freigegeben"); icon: Icons.check; clicked => { AppState.tan-confirmed(); } }
        if AppState.tan-kind != 3: PrimaryButton { text: @tr("TAN senden"); icon: Icons.check; clicked => { AppState.tan-ok(); } }
    }
}

export component ChoiceDialog inherits Modal {
    Text { text: AppState.choice-title; font-size: 18px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
    for c in AppState.choices: Rectangle {
        height: 58px;
        border-radius: 8px;
        border-width: 1px;
        border-color: ta.has-hover ? Theme.accent : Theme.card-border;
        background: ta.has-hover ? Theme.accent-soft : Theme.card-bg;
        VerticalLayout {
            padding-left: 14px;
            alignment: center;
            spacing: 4px;
            Text { text: c.title; font-weight: 600; color: Theme.text; }
            if c.subtitle != "": Text { text: c.subtitle; font-size: 12px; color: Theme.text-muted; }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { AppState.choice-picked(c.key); }
        }
    }
    HorizontalLayout {
        alignment: end;
        GhostButton { text: @tr("Abbrechen"); clicked => { AppState.choice-cancel(); } }
    }
}

export component ConfirmDialog inherits Modal {
    Text { text: AppState.confirm-title; font-size: 18px; font-weight: 700; color: Theme.text; }
    Text { text: AppState.confirm-text; wrap: word-wrap; color: Theme.text-muted; }
    HorizontalLayout {
        alignment: end;
        spacing: 10px;
        GhostButton { text: @tr("Abbrechen"); clicked => { AppState.confirm-cancel(); } }
        PrimaryButton { text: AppState.confirm-ok-text != "" ? AppState.confirm-ok-text : AppState.confirm-danger ? @tr("Löschen") : @tr("Ausführen"); danger: AppState.confirm-danger; clicked => { AppState.confirm-ok(); } }
    }
}

export component BusyOverlay inherits Rectangle {
    background: #0b142460;
    TouchArea { }
    Rectangle {
        width: 380px;
        height: 84px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card-bg;
        border-radius: 12px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;
        HorizontalLayout {
            padding: 20px;
            spacing: 16px;
            Spinner {
                width: 30px;
                height: 30px;
                y: 7px;
                indeterminate: true;
            }
            Text {
                text: AppState.busy-text;
                vertical-alignment: center;
                wrap: word-wrap;
                color: Theme.text;
            }
        }
    }
}

export component PayeeDialog inherits Rectangle {
    background: #0b1424a0;
    TouchArea { }
    Rectangle {
        width: min(640px, parent.width - 40px);
        height: min(body.preferred-height + footer.preferred-height + 64px, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card-bg;
        border-radius: 14px;
        VerticalLayout {
            padding: 24px;
            spacing: 20px;
            ScrollView {
                content-width: self.visible-width;
                body := VerticalLayout {
                    spacing: 14px;
                    padding-right: 12px;
                    Text { text: @tr("Empfängerprüfung"); color: Theme.text; font-size: 22px; font-weight: 700; wrap: word-wrap; }
                    Text {
                        text: AppState.vop-status == 0 ? @tr("Name und IBAN stimmen überein") : AppState.vop-status == 1 ? @tr("Der Empfängername weicht leicht ab") : AppState.vop-status == 2 ? @tr("Name und IBAN stimmen nicht überein") : @tr("Empfängerprüfung nicht möglich");
                        color: AppState.vop-status == 0 ? Theme.success-text : Theme.warning;
                        font-size: 17px; font-weight: 700; wrap: word-wrap;
                    }
                    Text { text: @tr("Empfänger") + ": " + AppState.vop-name; color: Theme.text; wrap: word-wrap; }
                    Text { text: "IBAN: " + AppState.vop-iban; color: Theme.text-muted; wrap: word-wrap; }
                    if AppState.vop-suggested-name != "": Text { text: @tr("Name bei der Empfängerbank") + ": " + AppState.vop-suggested-name; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                    if AppState.vop-suggested-name != "": HorizontalLayout {
                        GhostButton { text: @tr("Namen kopieren"); clicked => { AppState.vop-copy-name(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if AppState.vop-reason != "": Text { text: AppState.vop-reason; color: Theme.text-muted; wrap: word-wrap; }
                    if AppState.vop-status != 0 && !AppState.vop-executed: Text { text: @tr("Wenn Sie fortfahren, kann das Geld auf ein Konto gelangen, dessen Inhaber nicht dem angegebenen Empfänger entspricht. Prüfen Sie die Angaben vor der Freigabe."); color: Theme.text; wrap: word-wrap; }
                    if AppState.vop-notice != "": Text { text: @tr("Hinweis Ihrer Bank"); color: Theme.text; font-weight: 600; }
                    if AppState.vop-notice != "": Text { text: AppState.vop-notice; color: Theme.text-muted; wrap: word-wrap; }
                    Text { text: AppState.vop-executed ? @tr("Die Bank hat den Auftrag bereits ausgeführt.") : @tr("Zum Ändern des Empfängernamens brechen Sie ab und senden den korrigierten Auftrag erneut zur Prüfung."); color: Theme.text-faint; wrap: word-wrap; }
                }
            }
            footer := HorizontalLayout {
                vertical-stretch: 0;
                spacing: 12px;
                alignment: end;
                if !AppState.vop-executed: GhostButton { text: @tr("Abbrechen"); clicked => { AppState.vop-cancel(); } }
                PrimaryButton {
                    text: AppState.vop-executed ? @tr("Schließen") : AppState.vop-status == 0 ? @tr("Weiter zur Freigabe") : @tr("Trotzdem fortfahren");
                    clicked => { AppState.vop-accept(); }
                }
            }
        }
    }
}
