import { LineEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { AccountDropTarget, AccountRow, AccountGroupRow, GroupBalanceRow, TxRow, TxDetail, BarStat, MonthStat, StandingRow, AccessRow, ChoiceRow, BankRow, Toast, PaymentOrderRow } from "types.slint";
import { Icon, Icons, NavItem, PrimaryButton, GhostButton } from "widgets.slint";
import { OverviewPage, AccountsPage, TransactionsPage, TransferPage, OrdersPage, StandingPage, AnalysisPage, AccessesPage, ReaderPage, SettingsPage } from "pages.slint";
import { AccountNameDialog, PayeeDialog, PinDialog, PinpadOverlay, TanDialog, ChoiceDialog, ConfirmDialog, BusyOverlay } from "dialogs.slint";

export { AccountDropTarget, AppState, Palette, AccountRow, AccountGroupRow, GroupBalanceRow, TxRow, TxDetail, BarStat, MonthStat, StandingRow, AccessRow, ChoiceRow, BankRow, Toast, PaymentOrderRow }

component Logo inherits HorizontalLayout {
    spacing: 10px;
    Image {
        width: 38px;
        height: 38px;
        source: @image-url("../../macos/bankingcraft-icon.png");
        image-fit: contain;
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Text { text: "BankingCraft"; color: #ffffff; font-size: 18px; font-weight: 700; }
        Text { text: @tr("Online-Banking"); color: Theme.nav-text-muted; font-size: 11px; }
    }
}

component UnlockScreen inherits Rectangle {
    property <string> pw1;
    property <string> pw2;
    property <int> selection-revision: AppState.vault-selection-revision;
    changed selection-revision => { root.pw1 = ""; root.pw2 = ""; p1.focus(); }
    background: @linear-gradient(140deg, #13233a 0%, #1e3f6b 60%, #1e6fd9 100%);
    TouchArea { }
    Rectangle {
        width: 560px;
        height: min(root.height - 48px, box.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card-bg;
        border-radius: 16px;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000055;
        ScrollView {
            box := VerticalLayout {
                padding: 28px;
                spacing: 12px;
                Text {
                    text: AppState.first-run ? @tr("Neuen Tresor anlegen") : @tr("BankingCraft entsperren");
                    font-size: 22px;
                    font-weight: 700;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if AppState.recent-vaults.length > 1: VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("Zuletzt geöffnete Tresore"); color: Theme.text-muted; font-size: 12px; }
                    ComboBox {
                        model: AppState.recent-vaults;
                        current-index <=> AppState.selected-vault;
                        selected(_) => { AppState.choose-vault(self.current-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    GhostButton { text: @tr("Tresor öffnen …"); clicked => { AppState.open-vault-file(); } }
                    GhostButton { text: @tr("Neuen Tresor anlegen …"); clicked => { AppState.new-vault-file(); } }
                }
                Text { text: AppState.selected-vault-name; color: Theme.text; font-size: 17px; font-weight: 650; wrap: word-wrap; }
                Text { text: AppState.selected-vault-path; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
                Text {
                    text: AppState.first-run
                        ? @tr("Legen Sie ein Tresor-Passwort fest. Damit werden Konten, Umsätze und Zugangsdaten lokal verschlüsselt.")
                        : @tr("Geben Sie das Passwort für den ausgewählten Tresor ein.");
                    wrap: word-wrap;
                    color: Theme.text-muted;
                    font-size: 13px;
                }
                p1 := LineEdit {
                    input-type: password;
                    placeholder-text: @tr("Tresor-Passwort");
                    text <=> root.pw1;
                    accepted => {
                        if !AppState.first-run { AppState.unlock(root.pw1); root.pw1 = ""; }
                    }
                }
                if AppState.first-run: LineEdit {
                    input-type: password;
                    placeholder-text: @tr("Passwort wiederholen");
                    text <=> root.pw2;
                    accepted => { AppState.create-vault(root.pw1, root.pw2); root.pw1 = ""; root.pw2 = ""; }
                }
                if AppState.unlock-error != "": Text {
                    text: AppState.unlock-error;
                    color: Theme.negative;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if AppState.unlocked: Text {
                    text: @tr("Beim Öffnen eines anderen Tresors werden ungespeicherte Formulare verworfen.");
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    if AppState.unlocked: GhostButton {
                        y: (parent.height - self.height) / 2;
                        text: @tr("Abbrechen");
                        clicked => { AppState.cancel-vault-selection(); }
                    }
                    PrimaryButton {
                        text: AppState.first-run ? @tr("Tresor anlegen") : @tr("Entsperren");
                        clicked => {
                            if AppState.first-run { AppState.create-vault(root.pw1, root.pw2); }
                            else { AppState.unlock(root.pw1); }
                            root.pw1 = "";
                            root.pw2 = "";
                        }
                    }
                }
            }
        }
    }
    init => { p1.focus(); }
}

export component AppWindow inherits Window {
    icon: @image-url("../../macos/bankingcraft-icon.png");
    title: AppState.unlocked && AppState.active-vault-name != "" ? "BankingCraft · " + AppState.active-vault-name : "BankingCraft";
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 1100px;
    min-height: 680px;
    background: Theme.page-bg;
    default-font-size: Theme.font-normal;

    if !AppState.unlocked: UnlockScreen { }

    if AppState.unlocked: HorizontalLayout {
        // ------------------------------------------------ navigation rail
        Rectangle {
            width: 236px;
            background: Theme.nav-bg;
            VerticalLayout {
                padding: 14px;
                padding-top: 20px;
                spacing: 3px;
                Logo { padding-left: 6px; padding-bottom: 22px; }
                NavItem { label: @tr("Übersicht"); icon: Icons.overview; active: AppState.page == 0; clicked => { AppState.navigate(0); } }
                NavItem { label: @tr("Konten"); icon: Icons.bank; active: AppState.page == 1; clicked => { AppState.navigate(1); } }
                NavItem { label: @tr("Umsätze"); icon: Icons.list; active: AppState.page == 2; clicked => { AppState.navigate(2); } }
                Text {
                    text: @tr("ZAHLUNGSVERKEHR");
                    color: Theme.nav-text-muted;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    height: 34px;
                    vertical-alignment: bottom;
                    x: 12px;
                }
                NavItem { label: @tr("Überweisung"); icon: Icons.transfer; active: AppState.page == 3; clicked => { AppState.navigate(3); } }
                NavItem { label: @tr("Auftragsliste") + (AppState.queued-order-count > 0 ? " (" + AppState.queued-order-count + ")" : ""); icon: Icons.list; active: AppState.page == 9; clicked => { AppState.navigate(9); } }
                NavItem { label: @tr("Daueraufträge"); icon: Icons.repeat; active: AppState.page == 4; clicked => { AppState.navigate(4); } }
                Text {
                    text: @tr("FINANZEN");
                    color: Theme.nav-text-muted;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    height: 34px;
                    vertical-alignment: bottom;
                    x: 12px;
                }
                NavItem { label: @tr("Auswertungen"); icon: Icons.chart; active: AppState.page == 5; clicked => { AppState.navigate(5); } }
                Rectangle { vertical-stretch: 1; }
                NavItem { label: @tr("Bankzugänge"); icon: Icons.key; active: AppState.page == 6; clicked => { AppState.navigate(6); } }
                NavItem { label: @tr("Kartenleser"); icon: Icons.reader; active: AppState.page == 7; clicked => { AppState.navigate(7); } }
                NavItem { label: @tr("Einstellungen"); icon: Icons.settings; active: AppState.page == 8; clicked => { AppState.navigate(8); } }
            }
        }
        // ------------------------------------------------ content
        Rectangle {
            if AppState.page == 0: OverviewPage { }
            if AppState.page == 1: AccountsPage { }
            if AppState.page == 2: TransactionsPage { }
            if AppState.page == 3: TransferPage { }
            if AppState.page == 4: StandingPage { }
            if AppState.page == 5: AnalysisPage { }
            if AppState.page == 6: AccessesPage { }
            if AppState.page == 7: ReaderPage { }
            if AppState.page == 8: SettingsPage { }
            if AppState.page == 9: OrdersPage { }
        }
    }

    // ---------------------------------------------------- overlays
    if AppState.unlocked && AppState.show-vault-manager: UnlockScreen { }
    if AppState.busy && !AppState.show-pin && !AppState.show-tan && !AppState.show-choice && !AppState.show-pinpad: BusyOverlay { }
    if AppState.show-pin: PinDialog { }
    if AppState.show-tan: TanDialog { }
    if AppState.show-pinpad: PinpadOverlay { }
    if AppState.show-choice: ChoiceDialog { }
    if AppState.show-confirm: ConfirmDialog { }
    if AppState.show-account-name: AccountNameDialog { }
    if AppState.show-vop: PayeeDialog { }

    if AppState.toast.visible: Rectangle {
        x: (parent.width - self.width) / 2 + 118px;
        y: parent.height - self.height - 24px;
        width: min(640px, toast-text.preferred-width + 80px);
        height: max(48px, toast-text.preferred-height + 24px);
        border-radius: 10px;
        background: AppState.toast.error ? #3a1418 : #13233a;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000050;
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 8px;
            spacing: 10px;
            toast-text := Text {
                text: AppState.toast.text;
                color: AppState.toast.error ? #ffc9cd : #ffffff;
                vertical-alignment: center;
                wrap: word-wrap;
                max-width: 560px;
            }
            Rectangle {
                width: 30px;
                Icon { name: Icons.close; color: #ffffff; width: 16px; height: 16px; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppState.toast-close(); }
                }
            }
        }
    }
}
